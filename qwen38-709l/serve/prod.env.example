# The measured "allkv" config (see docs/RESULTS.md). Copy to prod.env next to serve-709l.sh.
# Pin the card. With torch 2.14 a container-level ONEAPI_DEVICE_SELECTOR alone was not enough for us; ZE_AFFINITY_MASK
# picks the card by its Level Zero index (0 = first B70).
unset ONEAPI_DEVICE_SELECTOR
export ZE_AFFINITY_MASK=0
# riceharvest b70 layer (needs the v2 attention .so for B70_SPEC_PACKED)
export B70_SPEC_PACKED=1 B70_TARGET_LMHEAD_FP8=1 B70_EMBED_UVA=1
# Gone since the 0.32 stack: B70_GRAPH_KV_SPLITS (patch dropped, no gain measured on 0.31) and B70_GDN_ZERO_DRAFT /
# B70_GDN_MIXED_NO_SYNC (vLLM 0.32 rewrote the GDN speculative-decode metadata path; its no-sync slicing is upstream now).
# The compile cache is keyed on config, not on env: one cache dir per switch combination, or a stale graph gets reused.
export VLLM_CACHE_ROOT=$VENV/cache/allkv
# Logs go to stdout/stderr. If something supervises the server (llama-swap, systemd, docker), leave it that way:
# an `exec >> file` here hides every line from the supervisor's log view.
