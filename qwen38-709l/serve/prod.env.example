# The measured "allkv" config (see docs/RESULTS.md). Copy to prod.env next to serve-709l.sh.
# Pin the card. With torch 2.14 a container-level ONEAPI_DEVICE_SELECTOR alone was not enough for us; ZE_AFFINITY_MASK
# picks the card by its Level Zero index (0 = first B70).
unset ONEAPI_DEVICE_SELECTOR
export ZE_AFFINITY_MASK=0
# riceharvest b70 layer (needs the v2 attention .so for B70_SPEC_PACKED)
export B70_SPEC_PACKED=1 B70_TARGET_LMHEAD_FP8=1 B70_EMBED_UVA=1
# Gone since the 0.32 stack: B70_GRAPH_KV_SPLITS (patch dropped, no gain measured on 0.31) and B70_GDN_ZERO_DRAFT /
# B70_GDN_MIXED_NO_SYNC (vLLM 0.32 rewrote the GDN speculative-decode metadata path; its no-sync slicing is upstream now).
# The compile cache is keyed on config, not on env: one cache dir per switch combination, or a stale graph gets reused.
export VLLM_CACHE_ROOT=$VENV/cache/allkv
# Combined copy + MTP speculator with probabilistic drafts (our live config since 2026-10-23). Needs patches/combo-spec/
# applied on top of apply_stack.sh; see patches/combo-spec/README.md. Uncomment all five lines together. Drop
# "draft_sample_method":"probabilistic" for vLLM's default greedy drafts (the 2026-10-21 config).
# export B70_SPEC_PACKED_QLENS=2,3,6,16 B70_GDN_VARLEN_SPEC=6,16 B70_COMBO_SPEC=1
# export B70_COMBO_MAX_CTX=262144 B70_COMBO_SCAN_CTX=262144
# Needed with the combined speculator (since 2026-10-25): copies the GDN state back when a 16-token step was followed
# by a shorter one at a block edge. Needs patches/combo-spec/patch_align_backward_precopy_032.py on the tree.
# export B70_ALIGN_BACKWARD_PRECOPY=1
# SPEC='{"method":"mtp","num_speculative_tokens":15,"num_speculative_tokens_per_batch_size":[[1,1,15],[2,4,5]],"rejection_sample_method":"block","draft_sample_method":"probabilistic"}'
# export VLLM_CACHE_ROOT=$VENV/cache/combo-prob
# Shortlist draft head (live since 2026-10-22): the MTP drafter scores 128 candidate rows instead of its whole 98,816-row
# int4 head, -3.4% step time at every depth. Needs patches/shortlist/patch_shortlist_032.py on the tree and the artifact
# from patches/shortlist/build_factors.py (see patches/shortlist/README.md). Unset = the stock draft head.
# export B70_DRAFT_SHORTLIST=$VENV/shortlist/shortlist_r512.pt B70_DRAFT_SHORTLIST_N=128
# V-split verify kernel (live since 2026-10-25): MTP-5 verify steps read the KV once per step, decode at 210k +23%.
# Needs the library built with patches/vsplit-verify/b70-verify-kernels.patch AND
# patches/vsplit-verify/patch_spec_packed_vsplit_032.py on rh-runtime (see patches/vsplit-verify/README.md). The kernel
# and the runtime both read this one switch; with riceharvest's library it does nothing.
# export B70_SPEC_VSPLIT=1
# Logs go to stdout/stderr. If something supervises the server (llama-swap, systemd, docker), leave it that way:
# an `exec >> file` here hides every line from the supervisor's log view.
