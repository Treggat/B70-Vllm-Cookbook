# Switches read by patches/patch_ink2_b70.py and the patched engine. Copy to inkling.env.
export B70_INK2_DSPARK=1                 # allow the DSpark drafter on XPU
export B70_INK2_MOE_TILE=128,64,16       # decode expert tiles: N,K,warps (engine default 128,128,8)
export B70_INK2_MOE_PREFILL=0,0,0,16     # prefill expert tiles: M,N,K,warps, 0 = keep the engine's choice
export B70_INK2_FP8KV=1                  # allow --kv-cache-dtype fp8 on XPU
